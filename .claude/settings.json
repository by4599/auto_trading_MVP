{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TRADING_BUILD_DIR": "C:/Users/SAMSUNG/auto_trading-build"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"C:/Users/SAMSUNG/Desktop/workspace/auto_trading/.claude/hooks/harness-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "하네스 규칙 적용 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"C:/Users/SAMSUNG/Desktop/workspace/auto_trading/.claude/hooks/harness-precommit-reminder.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "커밋 전 안전 점검"
          }
        ]
      }
    ]
  }
}

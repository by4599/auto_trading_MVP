# ─── 한국투자증권 (KIS) Open API ──────────────────────────────────────────────
# 모의투자 앱키: https://securities.koreainvestment.com → KIS Developers → 앱키 발급
KIS_APPKEY=your_paper_trading_appkey_here
KIS_SECRETKEY=your_paper_trading_secretkey_here

# 계좌번호 형식: "XXXXXXXX-XX" (예: 50000000-01) 또는 "XXXXXXXXXX" (예: 5000000001)
KIS_ACCOUNT_NO=50000000-01

# ─── 텔레그램 알림 (선택) ─────────────────────────────────────────────────────
# 봇 없으면 두 값 모두 비워두면 됨 — 알림만 비활성, 매매는 정상 동작
# 봇 생성: @BotFather 에게 /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
